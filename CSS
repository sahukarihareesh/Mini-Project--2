* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #f2f4f7;
}

.container {
  width: 90%;
  max-width: 900px;
  margin: 50px auto;
  background: white;
  padding: 30px;
  border-radius: 15px;
  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
}

h1 {
  text-align: center;
  margin-bottom: 30px;
  color: #222;
}

.input-section {
  display: flex;
  gap: 10px;
  margin-bottom: 30px;
}

.input-section input {
  flex: 1;
  padding: 12px;
  border: 1px solid #ccc;
  border-radius: 8px;
  font-size: 16px;
}

button {
  border: none;
  border-radius: 8px;
  padding: 10px 15px;
  cursor: pointer;
  font-size: 14px;
}

.add-btn {
  background: #007bff;
  color: white;
}

.add-btn:hover {
  background: #0056b3;
}

.summary {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 30px;
}

.summary div {
  flex: 1;
  text-align: center;
  padding: 20px;
  background: #f1f5f9;
  border-radius: 10px;
}

.summary h3 {
  margin-bottom: 10px;
  color: #555;
}

.summary p {
  font-size: 28px;
  font-weight: bold;
}

.student-section h2 {
  margin-bottom: 15px;
}

.student-section ul {
  list-style: none;
}

.student-section li {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 15px;
  margin-bottom: 10px;
  background: #f8f9fa;
  border-radius: 8px;
}

.student-name {
  flex: 1;
  font-weight: bold;
}

.present {
  color: green;
  font-weight: bold;
}

.absent {
  color: red;
  font-weight: bold;
}

.toggle-btn {
  background: #ffc107;
  color: #222;
}

.toggle-btn:hover {
  background: #e0a800;
}

.delete-btn {
  background: #dc3545;
  color: white;
}

.delete-btn:hover {
  background: #b02a37;
}

.empty {
  text-align: center;
  color: #777;
  padding: 20px;
}

@media (max-width: 600px) {
  .input-section {
    flex-direction: column;
  }

  .summary {
    flex-direction: column;
  }

  .student-section li {
    flex-wrap: wrap;
  }

  .student-name {
    width: 100%;
    flex: none;
  }
}
