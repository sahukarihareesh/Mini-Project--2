* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    min-height: 100vh;

    background: linear-gradient(135deg, #007bff, #00c6ff);

    display: flex;
    justify-content: center;
    align-items: center;
}

.container {
    width: 550px;
    background: white;
    padding: 40px;
    border-radius: 20px;

    text-align: center;

    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
}

h1 {
    color: #0077cc;
    margin-bottom: 30px;
    font-size: 30px;
}

.input-section {
    display: flex;
    gap: 12px;
    margin-bottom: 30px;
}

#studentName {
    flex: 1;
    padding: 14px;

    border: 2px solid #007bff;
    border-radius: 10px;

    font-size: 16px;
    outline: none;
}

#studentName:focus {
    border-color: #0056b3;
    box-shadow: 0 0 5px rgba(0, 123, 255, 0.4);
}

button {
    padding: 14px 22px;

    background: #007bff;
    color: white;

    border: none;
    border-radius: 10px;

    font-size: 16px;
    font-weight: bold;

    cursor: pointer;
}

button:hover {
    background: #0056b3;
}

h2 {
    color: #333;
    margin-bottom: 15px;
}

#studentList {
    list-style: none;
}

#studentList li {
    background: #f8f9fa;

    border-left: 5px solid #007bff;

    padding: 14px;
    margin: 10px 0;

    border-radius: 8px;

    text-align: left;
    font-size: 17px;
}
