body {
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
    background-color: #2196f3;
    min-height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;
}

.container {
    background-color: white;
    width: 500px;
    padding: 30px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
    text-align: center;
}

h1 {
    color: #1565c0;
    margin-bottom: 25px;
}

h2 {
    color: #333;
    margin-top: 25px;
}

.input-section {
    display: flex;
    gap: 10px;
    justify-content: center;
}

input {
    width: 60%;
    padding: 12px;
    border: 2px solid #2196f3;
    border-radius: 8px;
    font-size: 16px;
    outline: none;
}

button {
    padding: 12px 18px;
    background-color: #1565c0;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    cursor: pointer;
}

button:hover {
    background-color: #0d47a1;
}

#studentList {
    list-style: none;
    padding: 0;
}

#studentList li {
    background-color: white;
    border: 2px solid #2196f3;
    padding: 12px;
    margin: 10px 0;
    border-radius: 8px;
    text-align: left;
}
